# =============================================================================
# TRADING BOT CONFIGURATION (.env)
# Copy this file to .env and fill in your real credentials.
# NEVER commit your .env or credentials.json to GitHub/Git.
# =============================================================================

# --- 1. TELEGRAM ALERTS & COMMAND BOT ---
# Create a bot via @BotFather on Telegram to get your token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your Chat ID via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Send notification on Telegram when bot starts or restarts
SEND_STARTUP_MESSAGE=true

# --- 2. GROQ AI ENGINE (Institutional Quantitative Analysis) ---
# Get free high-speed API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- 3. CLOUDINARY (Cloud Chart Image Hosting for Telegram Photos) ---
# Free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- 4. GOOGLE SHEETS CLOUD SYNC ---
# Option A (Recommended for Docker/Cloud): Paste raw JSON string of service account key
# e.g.: GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
GOOGLE_CREDENTIALS_JSON=

# Option B (Local fallback): Path to credentials.json file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Crypto_Liquidity_Signals
# true = log a heartbeat row every scan cycle in "Scan Log" tab
LOG_EVERY_CYCLE=true

# --- 5. SCANNER & MARKET PAIRS ---
# Comma-separated list of Binance USDT spot symbols
SYMBOLS=ETHUSDT,SOLUSDT,XRPUSDT,BTCUSDT,DOGEUSDT,PAXGUSDT,XAUTUSDT
# Comma-separated timeframes (e.g. 15m, 5m, 1h, 4h, 1m)
TIMEFRAMES=15m, 5m, 1h, 4h, 1m
# Interval between automated scanning cycles in seconds (default: 60)
SCAN_INTERVAL_SECONDS=60
# IANA Timezone for timestamps and day rollover (e.g. UTC, Asia/Kolkata, America/New_York)
TIMEZONE=UTC
# Binance public REST base URL (leave blank for auto fallback mirrors)
# BINANCE_BASE_URL=https://api.binance.com

# --- 6. ICT / SMC STRATEGY TUNING (Defaults shown below) ---
# SWING_K=3               # Candles each side that define a swing high/low (fractal)
# SWING_LOOKBACK=50       # Number of candles to search for liquidity pools
# RECLAIM_CANDLES=2       # Sweep candle (or next) must close back inside level
# MIN_SWEEP_ATR=0.10      # Min wick penetration beyond level in ATRs
# DISP_WINDOW=6           # Displacement must appear within N candles of sweep
# DISP_ATR_MULT=1.2       # Displacement candle body >= mult * ATR(14)
# REQUIRE_MSS=true        # Displacement must break opposing swing structure
# OB_BACK=3               # Order Block can sit up to N candles before sweep
# OB_USE_BODY=false       # false = full candle range, true = candle body only
# MAX_SETUP_AGE=12        # Displacement must be within last N candles
# TAP_TOLERANCE_ATR=1.0   # Price tolerance for live Order Block retest
# STOP_BUFFER_ATR=0.25    # Buffer added beyond sweep extreme for stop loss
# RR=2.0                  # Reference Risk-to-Reward ratio for take-profit target
