# Copy this file to .env and fill in your values. Never commit .env or credentials.json.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SEND_STARTUP_MESSAGE=true

# --- Google Sheets (service account) ---
ENABLE_SHEETS=auto                             # auto / true / false
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Crypto_Liquidity_Signals
LOG_EVERY_CYCLE=false                          # true = also append a row every scan

# --- Scanner ---
SYMBOLS=ETHUSDT,SOLUSDT,XRPUSDT,BTCUSDT,DOGEUSDT,PAXGUSDT
TIMEFRAME=15m                                  # 5m / 15m / 1h / 4h ...
SCAN_INTERVAL_SECONDS=300
TIMEZONE=UTC                                   # e.g. Asia/Kolkata

# --- Strategy tuning (defaults shown) ---
# SWING_K=3
# SWING_LOOKBACK=50
# DISP_ATR_MULT=1.2
# REQUIRE_MSS=true
# MAX_SETUP_AGE=12
# RR=2.0
